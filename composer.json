{
    "name": "stellarwp/slic",
    "description": "StellarWP Local Interactive Containers - containerized testing environment CLI tool for WordPress plugins, themes, and projects.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "phpcompatibility/php-compatibility": "dev-develop",
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload-dev": {
        "psr-4": {
            "StellarWP\\Slic\\Test\\": "tests/",
            "StellarWP\\Slic\\Test\\Support\\": "tests/_support"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "compat": "phpcs",
        "test": "phpunit"
    }
}
